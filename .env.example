EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Clé Groq — utilisée côté client (fallback local) ET dans les secrets Supabase Edge Functions
EXPO_PUBLIC_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# ── Web Push VAPID — clé PUBLIQUE (exposée au navigateur, sûre dans le bundle) ──
# Générer la paire : npx web-push generate-vapid-keys
# La clé PRIVÉE (VAPID_PRIVATE_KEY) ne va PAS ici — l'ajouter aux secrets Supabase :
#   npx supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=... VAPID_SUBJECT=mailto:admin@ootd.app
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ── Analyse IA — secrets SERVEUR uniquement (Supabase Edge Functions) ──
# JAMAIS exposées au client PWA (pas de préfixe EXPO_PUBLIC_, sinon la clé
# finirait en clair dans le bundle web). Définir via :
#   npx supabase secrets set GEMINI_API_KEY=AIzaSy...
#   npx supabase secrets set GROQ_API_KEY=gsk_...
# La fonction analyze-outfit tente Gemini (gemini-2.0-flash) puis Groq en repli.
GEMINI_API_KEY=ton_api_key_ici_commencant_par_AIzaSy
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# RevenueCat — clés publiques (dashboard.revenuecat.com > Project > API Keys)
EXPO_PUBLIC_RC_APPLE_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_GOOGLE_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
